.tab-bar {
  position: fixed;
  z-index: 999;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  height: calc(50px + constant(safe-area-inset-bottom));
  height: calc(50px + env(safe-area-inset-bottom));
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
}

.tab-bar__border {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 1px;
  background: #e5e6eb;
  transform: scaleY(0.5);
  transform-origin: center top;
}

.tab-bar__content {
  display: flex;
  height: 50px;
}

.tab-bar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 0;
}

.tab-bar__icon {
  display: block;
  width: 24px;
  height: 24px;
}

.tab-bar__label {
  overflow: hidden;
  max-width: 100%;
  margin-top: 2px;
  font-size: 11px;
  line-height: 14px;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
